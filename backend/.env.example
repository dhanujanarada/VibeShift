# Copy this file to .env for local development.
# Set these variables in Render's "Environment" tab for production.

# Comma-separated list of allowed CORS origins (in addition to the *.vercel.app regex).
# The regex already covers all *.vercel.app and localhost URLs, so this is optional.
# ALLOWED_ORIGINS=https://your-app.vercel.app

# HuggingFace repo containing best_final.pt and TimGM6mb.sf2.
# Defaults to "Nyarada/vibeshift-checkpoints" if not set.
HF_REPO_ID=Nyarada/vibeshift-checkpoints
